#!/bin/sh
# gcvx - thin Google Cloud Vertex AI execution wrapper for Claude Code.
#
# Subcommands:
#   gcvx init             initial local setup
#   gcvx doctor           read-only diagnostics
#   gcvx claude ...       run the ordinary claude CLI through Vertex AI
#   gcvx claude-acp       run the ACP agent (claude-agent-acp) through Vertex AI
#   gcvx team ...         run claude on the CALLER's provider, routing teammates
#                         to Vertex
#   gcvx claude-teammate  teammate entry point invoked by Claude Code
#
# This wrapper only selects the provider and default model via environment
# variables and then replaces itself with the real tool. It does not parse
# Claude Code arguments, manage sessions, or add any runtime of its own --
# except in `claude-teammate`, which must rewrite --model to hold the teammate
# model policy (see teammate_model_allowed).

set -eu

GCVX_VERSION="0.2.0"

# GCVX_CONFIG_DIR may be overridden (used by tests).
GCVX_CONFIG_DIR="${GCVX_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gcvx}"
GCVX_CONFIG_FILE="$GCVX_CONFIG_DIR/config"

usage() {
    cat <<'EOF'
Usage: gcvx <subcommand> [arguments...]

Subcommands:
  init          Create the gcvx configuration and check dependencies
  doctor        Run read-only diagnostics on the local setup
  claude        Run the ordinary claude CLI backed by Google Cloud Vertex AI
                (all remaining arguments are passed to claude unchanged)
  claude-acp    Start the ACP agent (claude-agent-acp) backed by Vertex AI
  team          Run claude on the caller's own provider (e.g. an Anthropic
                subscription) with teammates spawned as Vertex-backed tmux
                panes. Requires tmux.
  claude-teammate
                Teammate entry point. Invoked by Claude Code via
                CLAUDE_CODE_TEAMMATE_COMMAND, not normally by hand.

Configuration file: ~/.config/gcvx/config (see 'gcvx init')
EOF
}

# Absolute directory holding this script, used to locate sibling executables.
# $0 may be relative, or a bare name resolved through PATH.
gcvx_dir() {
    _self=$0
    case $_self in
        */*) ;;
        *) _self=$(command -v -- "$0" 2>/dev/null || printf '%s' "$0") ;;
    esac
    (CDPATH='' cd -- "$(dirname -- "$_self")" && pwd -P)
}

teammate_launcher() {
    printf '%s\n' "${GCVX_TEAMMATE_LAUNCHER:-$(gcvx_dir)/gcvx-teammate}"
}

err() {
    printf 'gcvx: %s\n' "$*" >&2
}

# ---------------------------------------------------------------------------
# Configuration

config_template() {
    cat <<'EOF'
# gcvx configuration.
# This file is sourced by /bin/sh. Keep it to simple VAR="value" assignments.

# Google Cloud project used for Vertex AI requests (required).
GCVX_GCP_PROJECT_ID="__PROJECT__"

# Vertex AI region. "global" is the default.
GCVX_GCP_REGION="__REGION__"

# Default Claude model for gcvx sessions. An explicit `--model` argument to
# `gcvx claude` still overrides this, per Claude Code's own precedence.
GCVX_CLAUDE_MODEL="__MODEL__"

# Model used by Vertex-backed teammates spawned from `gcvx team`.
# Teammates are spawned programmatically and can be numerous, so they get their
# own, cheaper default rather than inheriting GCVX_CLAUDE_MODEL.
GCVX_TEAMMATE_MODEL="claude-sonnet-5"

# Models a teammate is permitted to run. Whitespace-separated; both aliases and
# explicit ids must be listed, because the leader may request either. A model
# outside this list is rewritten to GCVX_TEAMMATE_MODEL with a warning -- this
# is what stops a leader from silently billing an expensive model to Vertex.
GCVX_TEAMMATE_ALLOWED_MODELS="sonnet claude-sonnet-5"

# Optional binary overrides.
#GCVX_CLAUDE_BIN="claude"
#GCVX_CLAUDE_ACP_BIN="claude-agent-acp"
#GCVX_ACPX_BIN="acpx"
EOF
}

load_config() {
    if [ ! -r "$GCVX_CONFIG_FILE" ]; then
        err "configuration not found at $GCVX_CONFIG_FILE"
        err "run 'gcvx init' first"
        exit 2
    fi
    # shellcheck disable=SC1090
    . "$GCVX_CONFIG_FILE"
    if [ -z "${GCVX_GCP_PROJECT_ID:-}" ]; then
        err "GCVX_GCP_PROJECT_ID is not set in $GCVX_CONFIG_FILE"
        exit 2
    fi
}

export_vertex_env() {
    export CLAUDE_CODE_USE_VERTEX=1
    export ANTHROPIC_VERTEX_PROJECT_ID="$GCVX_GCP_PROJECT_ID"
    export CLOUD_ML_REGION="${GCVX_GCP_REGION:-global}"
    export ANTHROPIC_MODEL="${GCVX_CLAUDE_MODEL:-claude-opus-5-5}"
}

# ---------------------------------------------------------------------------
# gcvx claude

run_claude() {
    load_config
    export_vertex_env
    exec "${GCVX_CLAUDE_BIN:-claude}" "$@"
}

# ---------------------------------------------------------------------------
# gcvx claude-acp
#
# ACP uses stdio transport: stdout belongs to the protocol. Nothing may be
# printed to stdout here; wrapper diagnostics go to stderr before exec.

run_claude_acp() {
    load_config
    export_vertex_env
    exec "${GCVX_CLAUDE_ACP_BIN:-claude-agent-acp}" "$@"
}

# ---------------------------------------------------------------------------
# gcvx team / gcvx claude-teammate
#
# `team` starts a leader session on whatever provider the caller already has
# and points Claude Code's teammate launcher at `claude-teammate`, which is
# Vertex-backed. Claude Code spawns tmux-mode teammates as separate processes,
# so leader and teammates can sit on different providers and credentials while
# keeping the in-session teammate protocol (SendMessage and the rest) intact.

teammate_model() {
    printf '%s\n' "${GCVX_TEAMMATE_MODEL:-claude-sonnet-5}"
}

teammate_model_allowed() {
    # Word splitting on the allowlist is intended.
    # shellcheck disable=SC2086
    for _allowed in ${GCVX_TEAMMATE_ALLOWED_MODELS:-sonnet claude-sonnet-5}; do
        [ "$1" = "$_allowed" ] && return 0
    done
    return 1
}

run_team() {
    # NOTE: deliberately does NOT call export_vertex_env. The leader keeps the
    # caller's provider (typically an Anthropic subscription); only teammates
    # go to Vertex. Exporting Vertex here would put both sides on Vertex and
    # defeat the entire purpose of this subcommand. The omission is the
    # feature -- do not "fix" it.
    #
    # load_config still runs, so a broken configuration fails here rather than
    # at the first teammate spawn, minutes into a session.
    load_config

    _launcher=$(teammate_launcher)
    if [ ! -x "$_launcher" ]; then
        err "teammate launcher is missing or not executable: $_launcher"
        err "reinstall gcvx (scripts/install.sh)"
        exit 2
    fi

    # Must be a single executable path: Claude Code validates the launcher as
    # one, so a "gcvx claude-teammate" string would not do.
    CLAUDE_CODE_TEAMMATE_COMMAND=$_launcher
    export CLAUDE_CODE_TEAMMATE_COMMAND

    exec "${GCVX_CLAUDE_BIN:-claude}" --teammate-mode tmux "$@"
}

run_claude_teammate() {
    load_config

    GCVX_CLAUDE_MODEL=$(teammate_model)
    export_vertex_env

    # Claude Code passes the leader's chosen model on the teammate's argv, and
    # argv beats ANTHROPIC_MODEL. Pinning through the environment alone is
    # therefore not enough: a leader asking for an expensive model would get
    # it, billed to Vertex. Rewrite anything outside the allowlist.
    _lock=$(teammate_model)
    _argc=$#
    _seen=0
    while [ "$_seen" -lt "$_argc" ]; do
        _arg=$1
        shift
        _seen=$((_seen + 1))
        case $_arg in
            --model)
                _value=""
                if [ "$_seen" -lt "$_argc" ]; then
                    _value=$1
                    shift
                    _seen=$((_seen + 1))
                fi
                if [ -n "$_value" ] && teammate_model_allowed "$_value"; then
                    set -- "$@" --model "$_value"
                else
                    [ -n "$_value" ] \
                        && err "teammate model '$_value' not allowed; using '$_lock'"
                    set -- "$@" --model "$_lock"
                fi
                ;;
            --model=*)
                _value=${_arg#--model=}
                if teammate_model_allowed "$_value"; then
                    set -- "$@" --model="$_value"
                else
                    err "teammate model '$_value' not allowed; using '$_lock'"
                    set -- "$@" --model="$_lock"
                fi
                ;;
            *)
                set -- "$@" "$_arg"
                ;;
        esac
    done

    exec "${GCVX_CLAUDE_BIN:-claude}" "$@"
}

# ---------------------------------------------------------------------------
# gcvx init

have() {
    command -v "$1" >/dev/null 2>&1
}

adc_file() {
    if [ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]; then
        printf '%s\n' "$GOOGLE_APPLICATION_CREDENTIALS"
    else
        printf '%s\n' "${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}/application_default_credentials.json"
    fi
}

prompt_value() {
    # prompt_value "Question" "default" -> echoes chosen value
    _q=$1 _d=$2
    if [ -t 0 ]; then
        printf '%s [%s]: ' "$_q" "$_d" >&2
        read -r _a || _a=""
        printf '%s\n' "${_a:-$_d}"
    else
        printf '%s\n' "$_d"
    fi
}

run_init() {
    mkdir -p "$GCVX_CONFIG_DIR"

    if [ -e "$GCVX_CONFIG_FILE" ]; then
        printf 'Configuration already exists at %s (not overwriting).\n' "$GCVX_CONFIG_FILE"
    else
        detected_project=""
        if have gcloud; then
            detected_project=$(gcloud config get-value project 2>/dev/null || true)
            [ "$detected_project" = "(unset)" ] && detected_project=""
        fi
        project=$(prompt_value "Google Cloud project id" "${GCVX_GCP_PROJECT_ID:-$detected_project}")
        region=$(prompt_value "Vertex AI region" "${GCVX_GCP_REGION:-global}")
        model=$(prompt_value "Default Claude model" "${GCVX_CLAUDE_MODEL:-claude-opus-5-5}")

        config_template \
            | sed -e "s|__PROJECT__|$project|" \
                  -e "s|__REGION__|$region|" \
                  -e "s|__MODEL__|$model|" \
            > "$GCVX_CONFIG_FILE"
        printf 'Wrote %s\n' "$GCVX_CONFIG_FILE"
        if [ -z "$project" ]; then
            printf 'NOTE: GCVX_GCP_PROJECT_ID is empty; edit %s before use.\n' "$GCVX_CONFIG_FILE"
        fi
    fi

    printf '\nDependency check:\n'
    for dep in gcloud claude claude-agent-acp acpx; do
        if have "$dep"; then
            printf '  ok       %s (%s)\n' "$dep" "$(command -v "$dep")"
        else
            printf '  missing  %s\n' "$dep"
            case $dep in
                gcloud)
                    printf '           install: https://cloud.google.com/sdk/docs/install\n' ;;
                claude)
                    printf '           install: npm install -g @anthropic-ai/claude-code\n' ;;
                claude-agent-acp)
                    printf '           install: npm install -g @agentclientprotocol/claude-agent-acp\n' ;;
                acpx)
                    printf '           install: npm install -g acpx\n' ;;
            esac
        fi
    done

    printf '\nApplication Default Credentials:\n'
    if [ -r "$(adc_file)" ]; then
        printf '  ok       %s\n' "$(adc_file)"
    else
        printf '  missing  run: gcloud auth application-default login\n'
    fi

    printf '\nNext step: run '\''gcvx doctor'\'' to validate the setup.\n'
}

# ---------------------------------------------------------------------------
# gcvx doctor

DOCTOR_FAILED=0

check() {
    # check "label" "hint" command...
    _label=$1 _hint=$2
    shift 2
    if "$@" >/dev/null 2>&1; then
        printf '  ok       %s\n' "$_label"
    else
        printf '  FAIL     %s\n' "$_label"
        [ -n "$_hint" ] && printf '           %s\n' "$_hint"
        DOCTOR_FAILED=1
    fi
}

doctor_acp_initialize() {
    # Verify the ACP server responds to an `initialize` request over stdio.
    # This spawns the agent but makes no model request.
    _req='{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":1,"clientCapabilities":{"fs":{"readTextFile":false,"writeTextFile":false}}}}'
    _out=$(printf '%s\n' "$_req" | timeout 20 "$0" claude-acp 2>/dev/null | head -n 1) || true
    case $_out in
        *'"result"'*) return 0 ;;
        *) return 1 ;;
    esac
}

run_doctor() {
    printf 'gcvx doctor (read-only; no model requests are made)\n\n'

    printf 'Configuration:\n'
    if [ -r "$GCVX_CONFIG_FILE" ]; then
        printf '  ok       config readable (%s)\n' "$GCVX_CONFIG_FILE"
        # shellcheck disable=SC1090
        . "$GCVX_CONFIG_FILE"
        if [ -n "${GCVX_GCP_PROJECT_ID:-}" ]; then
            printf '  ok       GCVX_GCP_PROJECT_ID=%s\n' "$GCVX_GCP_PROJECT_ID"
        else
            printf '  FAIL     GCVX_GCP_PROJECT_ID is not set\n'
            DOCTOR_FAILED=1
        fi
        # gcvx <= 0.2.0 generated GCVX_CLAUDE_MODEL="fable". On Vertex that
        # alias now resolves to a model the endpoint does not serve, and
        # `gcvx init` never rewrites an existing config, so flag it here.
        if [ "${GCVX_CLAUDE_MODEL:-}" = "fable" ]; then
            printf '  FAIL     GCVX_CLAUDE_MODEL="fable" resolves to a model Vertex does not serve\n'
            printf '           set GCVX_CLAUDE_MODEL="claude-opus-5-5" in %s\n' "$GCVX_CONFIG_FILE"
            DOCTOR_FAILED=1
        fi
    else
        printf '  FAIL     config not found at %s (run: gcvx init)\n' "$GCVX_CONFIG_FILE"
        DOCTOR_FAILED=1
    fi

    printf '\nGoogle Cloud:\n'
    check "gcloud available" "install: https://cloud.google.com/sdk/docs/install" \
        command -v gcloud
    check "Application Default Credentials present" \
        "run: gcloud auth application-default login" \
        test -r "$(adc_file)"
    if have gcloud && [ -n "${GCVX_GCP_PROJECT_ID:-}" ]; then
        check "project '$GCVX_GCP_PROJECT_ID' visible" \
            "check project id and permissions (gcloud projects describe)" \
            gcloud projects describe "$GCVX_GCP_PROJECT_ID"
    fi

    printf '\nBinaries:\n'
    check "claude available (${GCVX_CLAUDE_BIN:-claude})" \
        "install: npm install -g @anthropic-ai/claude-code" \
        command -v "${GCVX_CLAUDE_BIN:-claude}"
    check "claude-agent-acp available (${GCVX_CLAUDE_ACP_BIN:-claude-agent-acp})" \
        "install: npm install -g @agentclientprotocol/claude-agent-acp" \
        command -v "${GCVX_CLAUDE_ACP_BIN:-claude-agent-acp}"
    check "acpx available (${GCVX_ACPX_BIN:-acpx})" \
        "install: npm install -g acpx" \
        command -v "${GCVX_ACPX_BIN:-acpx}"

    printf '\nLaunch:\n'
    if [ -r "$GCVX_CONFIG_FILE" ] && [ -n "${GCVX_GCP_PROJECT_ID:-}" ]; then
        if have "${GCVX_CLAUDE_BIN:-claude}"; then
            check "gcvx claude --version launches" "" \
                "$0" claude --version
        fi
        if have "${GCVX_CLAUDE_ACP_BIN:-claude-agent-acp}" && have timeout; then
            check "gcvx claude-acp answers ACP initialize" \
                "check claude-agent-acp installation and Vertex configuration" \
                doctor_acp_initialize
        fi
    else
        printf '  skip     launch checks (configuration incomplete)\n'
    fi

    printf '\nTeammates (gcvx team):\n'
    check "tmux available" "install tmux; 'gcvx team' spawns teammates as tmux panes" \
        command -v tmux
    check "teammate launcher executable ($(teammate_launcher))" \
        "reinstall gcvx (scripts/install.sh)" \
        test -x "$(teammate_launcher)"
    if teammate_model_allowed "$(teammate_model)"; then
        printf '  ok       teammate model %s (allowed: %s)\n' \
            "$(teammate_model)" "${GCVX_TEAMMATE_ALLOWED_MODELS:-sonnet claude-sonnet-5}"
    else
        printf '  FAIL     teammate model %s is not in GCVX_TEAMMATE_ALLOWED_MODELS\n' \
            "$(teammate_model)"
        printf '           every teammate would be rewritten to a model you disallowed\n'
        DOCTOR_FAILED=1
    fi

    if [ "$DOCTOR_FAILED" -ne 0 ]; then
        printf '\nSome checks failed.\n'
        exit 1
    fi
    printf '\nAll checks passed.\n'
}

# ---------------------------------------------------------------------------
# Dispatch

[ $# -ge 1 ] || { usage >&2; exit 2; }

subcommand=$1
shift

case $subcommand in
    claude)      run_claude "$@" ;;
    claude-acp)  run_claude_acp "$@" ;;
    team)        run_team "$@" ;;
    claude-teammate) run_claude_teammate "$@" ;;
    init)        run_init "$@" ;;
    doctor)      run_doctor "$@" ;;
    -h|--help|help) usage ;;
    -V|--version|version) printf 'gcvx %s\n' "$GCVX_VERSION" ;;
    *)
        err "unknown subcommand: $subcommand"
        usage >&2
        exit 2
        ;;
esac
